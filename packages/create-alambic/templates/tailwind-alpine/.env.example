# Copy to `.env.dev.local`, `.env.preprod.local`, `.env.prod.local`
# and fill in real values per environment.
#
# API auth uses your `shopify auth login` OAuth session — no token here.
# Only set *_STORE_PASSWORD when the store has a public "Coming Soon"
# password page in front of the storefront.
#
# `.local` files are gitignored.

# --- dev ---
SHOPIFY_DEV_STORE=your-dev-store.myshopify.com
SHOPIFY_DEV_THEME_ID=
SHOPIFY_DEV_STORE_PASSWORD=

# --- preprod ---
SHOPIFY_PREPROD_STORE=your-preprod-store.myshopify.com
SHOPIFY_PREPROD_THEME_ID=
SHOPIFY_PREPROD_STORE_PASSWORD=

# --- prod ---
SHOPIFY_PROD_STORE=your-prod-store.myshopify.com
SHOPIFY_PROD_THEME_ID=
SHOPIFY_PROD_STORE_PASSWORD=
