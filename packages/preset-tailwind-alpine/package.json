{
  "name": "@alambic/preset-tailwind-alpine",
  "version": "0.0.0",
  "description": "Alambic preset: Tailwind v4 + Alpine.js. Reference implementation of the adapter contract.",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "CLAUDE.md"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./css": {
      "types": "./dist/css.d.mts",
      "import": "./dist/css.mjs"
    },
    "./js": {
      "types": "./dist/js.d.mts",
      "import": "./dist/js.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.mts",
      "import": "./dist/runtime.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@alambic/adapters": "workspace:*",
    "tinyglobby": "^0.2.10"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "alpinejs": "^3.14.9",
    "tailwindcss": "^4.1.16",
    "vite": "^8.0.12",
    "vite-plus": "^0.1.20",
    "vitest": "^4.1.6"
  },
  "peerDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "alpinejs": "^3.14.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "@tailwindcss/vite": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    },
    "alpinejs": {
      "optional": true
    }
  }
}
