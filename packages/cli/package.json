{
  "name": "@alambic/cli",
  "version": "0.0.0",
  "description": "Command-line interface for Alambic — Shopify theme devkit.",
  "license": "MIT",
  "bin": {
    "alambic": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "CLAUDE.md"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@alambic/core": "workspace:*",
    "@alambic/lsp": "workspace:*",
    "@alambic/schema": "workspace:*",
    "@alambic/types": "workspace:*",
    "commander": "^14.0.3",
    "jiti": "^2.7.0",
    "tinyglobby": "^0.2.10"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "vite": "^8.0.12",
    "vite-plus": "^0.1.20",
    "vitest": "^4.1.6"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
