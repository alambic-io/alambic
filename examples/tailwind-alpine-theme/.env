# Copy this file to `.env.dev.local`, `.env.preprod.local`, and `.env.prod.local`
# and fill in the values for each environment.
#
# Files ending in `.local` are gitignored and meant for secrets.
# Non-secret defaults (e.g. theme IDs of public preview themes) can live
# in committed `.env.[name]` files instead.

# --- dev ---
SHOPIFY_DEV_STORE=breeze-9970.myshopify.com
# Leave blank to let `shopify theme dev` use the hidden development theme.
SHOPIFY_DEV_THEME_ID=148778811529
SHOPIFY_DEV_STORE_PASSWORD=breeze

# --- preprod ---
SHOPIFY_PREPROD_STORE=your-preprod-store.myshopify.com
SHOPIFY_PREPROD_THEME_ID=123456789
SHOPIFY_PREPROD_STORE_PASSWORD=

# --- prod ---
SHOPIFY_PROD_STORE=your-prod-store.myshopify.com
SHOPIFY_PROD_THEME_ID=987654321
SHOPIFY_PROD_STORE_PASSWORD=
