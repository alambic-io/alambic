# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
**/dist/
*.tsbuildinfo

# Vite+ task cache
node_modules/.vite/

# Alambic generated artifacts
.alambic/
**/.alambic/

# Test artifacts
coverage/
**/coverage/

# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*

# Env files — Vite convention.
# `.env` and `.env.[name]` are committable (non-secret defaults).
# `.local` variants hold secrets and are never committed.
.env.local
.env.*.local

# Misc
.cache/
tmp/
